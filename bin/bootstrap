#!/bin/bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RUBY_VERSION="$(cat "$ROOT_DIR/.ruby-version")"

if [[ "$(uname)" = "Linux" ]]; then
  echo "*** installing Linux prerequisites"
  sudo apt install -y \
    build-essential \
    git \
    inotify-tools \
    libffi-dev \
    libyaml-dev \
    pkg-config \
    zlib1g-dev
fi

cd "$ROOT_DIR"

if command -v rv >/dev/null 2>&1; then
  echo "*** using rv (ruby $RUBY_VERSION)"
  rv ruby install
else
  echo "*** rv not found, using system Ruby"
fi

if ! gem list -i bundler >/dev/null 2>/dev/null; then
  gem install bundler
fi
bundle install

echo "*** installing git hooks"
mkdir -p .git/hooks
ln -sf "../../bin/hooks/pre-commit" .git/hooks/pre-commit

echo "*** done"
