<h1><%= h(@job.label || @job.kind) %></h1>

<div class="card" id="job" data-job="<%= h(@job.id) %>" data-state="<%= h(@job.state) %>">
  <p>
    <span class="pill <%= h(@job.state) %>" id="job-state"><%= h(@job.state) %></span>
    <span class="quiet" id="job-detail">
      <% if @job.result %><%= h(@job.result) %><% end %>
      <% if @job.error %><%= h(@job.error) %><% end %>
    </span>
  </p>
  <pre id="job-log"><% @job.lines.each do |line| %><%= h(line) %>
<% end %></pre>
</div>

<p><a href="/">Post another link</a> &middot; <a href="/drafts">Drafts</a></p>

<script>
  const box = document.getElementById("job");
  const log = document.getElementById("job-log");
  const state = document.getElementById("job-state");
  const detail = document.getElementById("job-detail");

  if (box.dataset.state === "running") {
    log.textContent = "";
    const source = new EventSource(`/jobs/${box.dataset.job}/stream`);
    source.onmessage = (event) => {
      const data = JSON.parse(event.data);
      if (data.type === "line") {
        log.textContent += data.text + "\n";
        log.scrollTop = log.scrollHeight;
        return;
      }
      state.textContent = data.state;
      state.className = `pill ${data.state}`;
      detail.textContent = data.error || data.result || "";
      box.dataset.state = data.state;
      source.close();
    };
    source.onerror = () => source.close();
  }
</script>
