<section class="card preview" id="preview-pane" hidden>
  <div class="preview-head">
    <strong>Preview</strong>
    <button type="button" class="secondary" id="preview-close">Close</button>
  </div>
  <p class="bad" id="preview-error" hidden></p>
  <div class="panes">
    <div>
      <h2>Web</h2>
      <iframe id="preview-html" title="HTML preview"></iframe>
    </div>
    <div>
      <h2>Gemini</h2>
      <pre id="preview-gemtext"></pre>
    </div>
  </div>
</section>

<script>
  const pane = document.getElementById("preview-pane");
  const previewError = document.getElementById("preview-error");
  const previewHtml = document.getElementById("preview-html");
  const previewGemtext = document.getElementById("preview-gemtext");
  const previewPanes = pane.querySelector(".panes");

  document.getElementById("preview-close").addEventListener("click", () => { pane.hidden = true; });

  // srcdoc inherits this page's origin, so the rendered post's own height is
  // readable. Fit both panes to it, floored so a one-liner isn't a sliver and
  // capped so a long post doesn't push the page miles down.
  function sizePanes() {
    const doc = previewHtml.contentDocument;
    if (!doc || !doc.body) return;
    const content = doc.documentElement.scrollHeight || doc.body.scrollHeight;
    const height = Math.min(Math.max(content + 8, 320), Math.round(window.innerHeight * 0.75));
    pane.style.setProperty("--preview-height", `${height}px`);
  }

  async function renderPreview(formData) {
    pane.hidden = false;
    previewError.hidden = true;
    previewPanes.hidden = false;
    previewGemtext.textContent = "Rendering…";
    try {
      const response = await fetch("/preview", { method: "POST", body: formData });
      const data = await response.json();
      if (!response.ok) {
        previewError.textContent = data.error || "Could not render a preview.";
        previewError.hidden = false;
        // Two empty boxes under an error message just look broken.
        previewPanes.hidden = true;
        previewGemtext.textContent = "";
        previewHtml.srcdoc = "";
        return;
      }
      previewHtml.srcdoc = data.html;
      previewGemtext.textContent = data.gemtext;
      previewHtml.addEventListener("load", sizePanes, { once: true });
    } catch (error) {
      previewError.textContent = String(error);
      previewError.hidden = false;
      previewPanes.hidden = true;
    }
    pane.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }
</script>
